{
  "name": "digital-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "agent-runtime": "github:tientran1234/agent-runtime",
    "durable-workflow": "github:tientran1234/durable-workflow",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "offline-license": "github:tientran1234/offline-license",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.4.0"
}
