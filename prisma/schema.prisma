generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  role          Role           @default(BUYER)
  sessions      Session[]
  products      Product[]
  orders        Order[]
  payoutAccount PayoutAccount?
  payouts       Payout[]
  subscriptions Subscription[]
  usage         UsageCounter[]
  traces        AgentTrace[]
  createdAt     DateTime       @default(now())
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// An outstanding sign-in link. Only the SHA-256 of the token is here: the
/// token itself lives in the email and in the URL the click carries, both of
/// which get logged by things we do not own, so the row on its own is not a
/// key to anything. No relation to User — a link can be asked for by an
/// address that has no account yet, and the account is created when the link
/// is clicked rather than when it is requested.
model LoginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  email      String
  /// The locale the link was asked for in, so the click lands in that language.
  locale     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

/// A digital product: one downloadable file plus the text we indexed from it.
model Product {
  id          String         @id @default(cuid())
  sellerId    String
  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  slug        String         @unique
  title       String
  description String
  priceMinor  Int
  currency    String         @default("usd")
  status      ProductStatus  @default(DRAFT)
  /// Original file name, for the download.
  fileName    String?
  /// Where the file lives (local path in dev, object key in prod).
  fileKey     String?
  chunks      ProductChunk[]
  orders      Order[]
  traces      AgentTrace[]
  views       ProductView[]
  /// The durable-workflow run that owns this product's review, if any.
  reviewRunId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([sellerId])
}

/// One chunk of a product's document, with its embedding. Written and queried
/// through raw SQL because Prisma cannot express the vector type or `<=>`.
model ProductChunk {
  id         String                 @id @default(cuid())
  productId  String
  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ordinal    Int
  heading    String?
  content    String
  tokenCount Int
  embedding  Unsupported("vector(1024)")?

  @@unique([productId, ordinal])
}

/// A one-time purchase. Status moves forward only (src/domain/order.ts).
model Order {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String
  status      String
  provider    String   @default("stripe")
  providerRef String?  @unique
  checkoutRef String?  @unique
  payout      Payout?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([buyerId, status])
  @@index([productId, status])
}

/// A seller's connected account at the provider. One per seller; the provider
/// owns the onboarding screens and the bank details, so all that is here is the
/// reference and whether that account may receive money yet.
model PayoutAccount {
  id             String   @id @default(cuid())
  sellerId       String   @unique
  seller         User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider       String   @default("stripe")
  accountRef     String   @unique
  payoutsEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A seller's share of one paid order: the gross, our fee, and what we owe.
/// One row per order — the unique orderId is what stops a replayed step owing
/// the same sale twice. Status moves forward only (src/domain/payout.ts).
model Payout {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountMinor Int
  feeMinor    Int
  netMinor    Int
  currency    String
  status      String
  provider    String   @default("stripe")
  /// The provider's transfer, once there is one.
  providerRef String?  @unique
  /// The durable-workflow run that owns this payout's money movements.
  runId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, status])
}

/// A membership plan. Status moves forward only (src/domain/subscription.ts).
model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey          String
  status           String
  provider         String    @default("stripe")
  providerRef      String?   @unique
  checkoutRef      String?   @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
}

/// Idempotency gate: provider event id is the primary key.
model WebhookEvent {
  providerEventId String   @id
  provider        String
  type            String
  receivedAt      DateTime @default(now())
}

/// Views of a product, counted per UTC day. One row a day rather than one row
/// a visit: the seller's report asks for a total, not for a log of who looked.
model ProductView {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  day       String
  count     Int     @default(0)

  @@id([productId, day])
}

/// Metered usage per user, per feature, per UTC month.
model UsageCounter {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature String
  period  String
  used    Int    @default(0)

  @@id([userId, feature, period])
}

/// One agent run, as exported by agent-runtime's tracer. The admin trace page reads this.
model AgentTrace {
  id           String   @id @default(cuid())
  runId        String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  status       String
  modelCalls   Int
  toolCalls    Int
  inputTokens  Int
  outputTokens Int
  costUsd      Float?
  durationMs   Int
  spans        Json
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
