# Postgres with the pgvector extension (Neon has it; `pnpm db:up` gives you one locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/marketplace?schema=public"

# Sessions — any long random string
SESSION_SECRET="change-me-to-32-random-bytes"

# Sign-in links. Unset means they are printed to the server log, which is the
# dev default. Setting one without the other is an error, not a fallback.
RESEND_API_KEY=""
MAIL_FROM="Marketplace <no-reply@example.test>"

# Sign in with Google. Unset means the button is not shown and an emailed link
# is the only way in, which is the dev default. Setting one without the other
# is an error, not a fallback. The redirect URI to register with Google is
# <APP_URL>/api/auth/oauth/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (test mode). Webhook secret comes from `pnpm stripe:listen`.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."       # monthly plan
APP_URL="http://localhost:3000"

# AI — chat via Claude, embeddings via Voyage (Anthropic's embeddings partner)
ANTHROPIC_API_KEY="sk-ant-..."
VOYAGE_API_KEY="pa-..."

# Object storage for product files. Unset means local disk, which is the dev
# default and ephemeral on Vercel. Any S3-compatible bucket: R2, MinIO, AWS S3.
S3_ENDPOINT=""                     # https://<account>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_REGION="auto"                   # "auto" on R2; the bucket's own region on AWS
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed the demo data the first time the app boots against an empty marketplace.
# For previews and fresh installs, not for production; see docs/deploy.md.
SEED_ON_BOOT=""

# Optional: license for the self-hosted edition (see docs/self-hosted.md)
LICENSE_TOKEN=""
LICENSE_PUBLIC_KEY=""
